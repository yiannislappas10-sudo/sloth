DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_test_server_id_here

# Moderation configuration
MOD_LOG_CHANNEL_ID=channel_id_where_mod_actions_are_logged
MUTED_ROLE_ID=role_id_for_the_muted_role

# Attach a Railway Volume at /data and use this path to preserve warnings.
DATA_FILE=/data/moderation.json
PRIDE_API_URL=https://your-pride-service.up.railway.app
PRIDE_API_KEY=use_the_same_secret_as_Pride

# Sloth -> Haven Institute website audit relay (same secret on both services)
WEBSITE_AUDIT_URL=https://sloth-website-production.up.railway.app
SLOTH_WEBHOOK_SECRET=generate_a-long-random-secret-and-use-the-same-value-on-both-services

# Website service only: configure Discord OAuth in the Discord Developer Portal.
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_REDIRECT_URI=https://sloth-website-production.up.railway.app/auth/callback
DISCORD_BOT_TOKEN=the_sloth_bot_token_for_reading_guild_owner_roles_and_channels
WEBSITE_DATA_DIR=/data/haven-site
